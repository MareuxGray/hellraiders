--!strict
-- Item catalogue (11 §11.2). Ids are ITM-<group>-<n>. Size is grid width x height, kg is weight, Value is the
-- Pawnbroker sell value in Mall Cash. Blueprints are ITM-BP-<Category>-<n> (12 §12.2). Vinyls (ITM-VIN) are
-- Relics with their own relicId and are not catalogue rows beyond ITM-VIN-000 and the ITM-VIN base.
-- Every number here is copied from blueprint 11, 12, 15, 17 and 18. Never add an item that isn't in the blueprint.

export type Tier = "Common" | "Uncommon" | "Rare" | "Epic" | "Exotic" | "Relic"
export type Group =
	"Gun"
	| "Melee"
	| "Ammo"
	| "Attachment"
	| "Armour"
	| "Pack"
	| "Gear"
	| "Keycard"
	| "Medical"
	| "Throwable"
	| "Material"
	| "Valuable"
	| "Blueprint"
	| "Relic"
	| "Decor"
	| "Tag"

export type Item = {
	id: string,
	name: string,
	group: Group,
	w: number,
	h: number,
	kg: number,
	tier: Tier,
	value: number,
	stack: number?, -- max stack size (1 when absent)
	displayable: string?, -- "yes" | "pedestal" | "case" | "wall"
	tradeable: boolean?, -- false for Dogtags, Blank Vinyl, raid-only items (16 §16.3)
	raidOnly: boolean?, -- vanishes on extract (safe code note)
	craftOnly: boolean?,
	model: string?, -- MDL-* id in 27 (world/held model)
	icon: string?, -- UI-ITM-* id in 27
	gun: string?, -- Config.Guns key
	pack: string?, -- Config.Packs key
	armour: string?, -- Config.Armour key
	category: string?, -- blueprint category (Guns | Armour | Attachments)
	unlocks: string?, -- blueprint: item id it unlocks
}

