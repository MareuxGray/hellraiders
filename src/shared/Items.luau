-- Blueprints (12 §12.2): one per category x model. Value by tier (11 §11.2).
local BLUEPRINT_VALUE = { Common = 2000, Rare = 6000, Epic = 15000, Exotic = 40000 }
local BLUEPRINT_ICON = { Guns = "UI-ITM-084", Armour = "UI-ITM-085", Attachments = "UI-ITM-086" }
local blueprintModels: { { category: string, tier: Tier, unlocks: string, name: string } } = {
	{ category = "Guns", tier = "Common", unlocks = "ITM-GUN-001", name = "P9" },
	{ category = "Guns", tier = "Rare", unlocks = "ITM-GUN-002", name = "Wasp" },
	{ category = "Guns", tier = "Rare", unlocks = "ITM-GUN-003", name = "Brace" },
	{ category = "Guns", tier = "Epic", unlocks = "ITM-GUN-004", name = "Kestrel" },
	{ category = "Guns", tier = "Epic", unlocks = "ITM-GUN-005", name = "Longhorn" },
	{ category = "Guns", tier = "Exotic", unlocks = "ITM-GUN-006", name = "Nightjar" },
	{ category = "Guns", tier = "Exotic", unlocks = "ITM-GUN-007", name = "Revenant" },
	{ category = "Armour", tier = "Rare", unlocks = "ITM-ARM-001", name = "Light Vest" },
	{ category = "Armour", tier = "Rare", unlocks = "ITM-ARM-003", name = "Helmet" },
	{ category = "Armour", tier = "Epic", unlocks = "ITM-ARM-002", name = "Heavy Vest" },
	{ category = "Armour", tier = "Exotic", unlocks = "ITM-ARM-004", name = "Bastion Plate" },
	{ category = "Attachments", tier = "Common", unlocks = "ITM-ATT-001", name = "Red Dot Sight" },
	{ category = "Attachments", tier = "Common", unlocks = "ITM-ATT-005", name = "Foregrip" },
	{ category = "Attachments", tier = "Rare", unlocks = "ITM-ATT-004", name = "Extended Mag" },
	{ category = "Attachments", tier = "Rare", unlocks = "ITM-ATT-002", name = "4× Scope" },
	{ category = "Attachments", tier = "Epic", unlocks = "ITM-ATT-003", name = "Suppressor" },
	{ category = "Attachments", tier = "Exotic", unlocks = "ITM-ATT-006", name = "Thermal Sight" },
}
do
	local counters: { [string]: number } = {}
	for _, bp in blueprintModels do
		counters[bp.category] = (counters[bp.category] or 0) + 1
		table.insert(list, {
			id = string.format("ITM-BP-%s-%03d", bp.category, counters[bp.category]),
			name = `Blueprint: {bp.name}`,
			group = "Blueprint",
			w = 1,
			h = 1,
			kg = 0,
			tier = bp.tier,
			value = BLUEPRINT_VALUE[bp.tier],
			category = bp.category,
			unlocks = bp.unlocks,
			model = "MDL-ITM-095",
			icon = BLUEPRINT_ICON[bp.category],
		})
	end
end

local byId: { [string]: Item } = {}
for _, item in list do
	assert(byId[item.id] == nil, `duplicate item id {item.id}`)
	byId[item.id] = item
end

Items.List = table.freeze(list)
Items.ById = table.freeze(byId)
Items.BlueprintModels = table.freeze(blueprintModels)
Items.TierOrder = table.freeze({ "Common", "Uncommon", "Rare", "Epic", "Exotic", "Relic" })

function Items.get(id: string): Item
	local item = byId[id]
	if item == nil then
		error(`Items: unknown item id {id}`, 2)
	end
	return item
end

function Items.has(id: string): boolean
	return byId[id] ~= nil
end

--- Items of a tier and (optionally) group, excluding craft-only, raid-only and Relic rows unless asked.
function Items.where(filter: { tier: Tier?, group: Group?, includeCraftOnly: boolean?, category: string? }): { Item }
	local out = {}
	for _, item in list do
		if filter.tier and item.tier ~= filter.tier then
			continue
		end
		if filter.group and item.group ~= filter.group then
			continue
		end
		if filter.category and item.category ~= filter.category then
			continue
		end
		if item.craftOnly and not filter.includeCraftOnly then
			continue
		end
		if item.id == "ITM-VIN" then
			continue
		end
		table.insert(out, item)
	end
	return out
end

--- Blueprint item ids for a category at a tier (wheel and trade-up outputs, 12 §12.5).
function Items.blueprintsAt(category: string, tier: Tier): { Item }
	return Items.where({ group = "Blueprint", category = category, tier = tier, includeCraftOnly = true })
end

--- Weight of a stack (ammo and planks list kg per full stack).
function Items.weight(item: Item, qty: number?): number
	local n = qty or 1
	if item.stack and item.stack > 1 then
		return item.kg * (n / item.stack)
	end
	return item.kg * n
end

function Items.isTradeable(item: Item): boolean
	if item.tradeable == false or item.raidOnly or item.tier == "Relic" then
		return false
	end
	return true
end

return Items
